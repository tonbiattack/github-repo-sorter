{
  "name": "github-repo-sorter",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub のリポジトリ一覧を、作成・Fork・Push を統合した最近の活動順に並べ替える Chrome 拡張",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:browser": "node scripts/browser-check.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
