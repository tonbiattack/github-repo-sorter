{
  "name": "github-repo-sorter",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "description": "Sort GitHub repositories by recent activity, including creation, forks, and pushes, directly in GitHub.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run verify && npm run package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:browser": "node scripts/browser-check.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
